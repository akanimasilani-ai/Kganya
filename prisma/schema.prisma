generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              Role      @default(CUSTOMER)
  status            AccountStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  customerProfile   CustomerProfile?
  adminProfile      AdminProfile?
  applications      Application[]
  policies          Policy[]
  claims            Claim[]
  documents         Document[]
  cateringEnquiries CateringEnquiry[]
  tombstoneEnquiries TombstoneEnquiry[]
  payments          Payment[]
  notifications     Notification[]
  messages          Message[]
  supportTickets    SupportTicket[]
  sessions          Session[]
  auditLogs         AuditLog[]
  
  @@index([email])
  @@index([role])
  @@index([status])
}

model Session {
  id                String  @id @default(cuid())
  sessionToken      String  @unique
  userId            String
  expires           DateTime
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model CustomerProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  identificationNumber  String?
  identificationType    String?
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  city                  String?
  province              String?
  postalCode            String?
  country               String    @default("ZA")
  occupation            String?
  maritalStatus         String?
  preferredContactMethod String  @default("email")
  consentToMarketing    Boolean   @default(false)
  consentToPOPIA        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model AdminProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  department    String?
  title         String?
  permissions   String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  DECLINED
  CANCELLED
  COMPLETED
}

model FuneralProduct {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  description       String?
  minAge            Int       @default(18)
  maxAge            Int       @default(70)
  minCover          Decimal   @db.Decimal(10, 2)
  maxCover          Decimal   @db.Decimal(10, 2)
  basePremium       Decimal   @db.Decimal(10, 2)
  features          String[]  @default([])
  benefits          String[]  @default([])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  applications      Application[]
  policies          Policy[]
  
  @@index([isActive])
}

model Application {
  id                    String    @id @default(cuid())
  referenceNumber       String    @unique
  userId                String
  productId             String
  status                ApplicationStatus @default(DRAFT)
  
  firstName             String
  lastName              String
  email                 String
  phone                 String
  dateOfBirth           DateTime
  identificationNumber  String
  occupationStatus      String?
  
  coverAmount           Decimal   @db.Decimal(10, 2)
  estimatedMonthlyPremium Decimal @db.Decimal(10, 2)
  additionalInfo        String?   @db.Text
  
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  infoRequestedAt       DateTime?
  decisionAt            DateTime?
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product               FuneralProduct @relation(fields: [productId], references: [id])
  beneficiaries         Beneficiary[]
  documents             ApplicationDocument[]
  notes                 ApplicationNote[]
  policy                Policy?
  auditTrail            AuditLog[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([referenceNumber])
  @@index([createdAt])
}

model ApplicationNote {
  id              String    @id @default(cuid())
  applicationId   String
  note            String    @db.Text
  createdBy       String
  isInternalOnly  Boolean   @default(true)
  createdAt       DateTime  @default(now())
  
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@index([applicationId])
}

model Beneficiary {
  id                String    @id @default(cuid())
  applicationId     String
  firstName         String
  lastName          String
  relationshipToApplicant String
  email             String?
  phone             String?
  dateOfBirth       DateTime?
  percentageShare   Int       @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  policyBeneficiaries PolicyBeneficiary[]
  
  @@index([applicationId])
}

enum PolicyStatus {
  PENDING
  ACTIVE
  LAPSED
  CANCELLED
  EXPIRED
  SUSPENDED
}

model Policy {
  id                String    @id @default(cuid())
  policyNumber      String    @unique
  userId            String
  applicationId     String    @unique
  productId         String
  status            PolicyStatus @default(PENDING)
  
  coverAmount       Decimal   @db.Decimal(10, 2)
  monthlyPremium    Decimal   @db.Decimal(10, 2)
  effectiveDate     DateTime
  expiryDate        DateTime?
  paymentStatus     String    @default("PENDING")
  paymentMethod     String?
  paymentFrequency  String    @default("MONTHLY")
  
  issuedAt          DateTime  @default(now())
  lastPaymentDate   DateTime?
  nextPaymentDate   DateTime?
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       Application @relation(fields: [applicationId], references: [id])
  product           FuneralProduct @relation(fields: [productId], references: [id])
  beneficiaries     PolicyBeneficiary[]
  claims            Claim[]
  payments          Payment[]
  debitOrders       DebitOrder[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([policyNumber])
}

model PolicyBeneficiary {
  id              String    @id @default(cuid())
  policyId        String
  beneficiaryId   String
  percentageShare Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  policy          Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  beneficiary     Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  
  @@unique([policyId, beneficiaryId])
  @@index([policyId])
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  DECLINED
  PROCESSING
  COMPLETED
}

model Claim {
  id                  String    @id @default(cuid())
  referenceNumber     String    @unique
  userId              String
  policyId            String
  status              ClaimStatus @default(SUBMITTED)
  
  claimantFirstName   String
  claimantLastName    String
  claimantEmail       String
  claimantPhone       String
  claimantRelationship String
  
  deceasedFirstName   String
  deceasedLastName    String
  deceasedDateOfBirth DateTime
  deceasedDateOfDeath DateTime
  causeOfDeath        String?
  
  claimDescription    String    @db.Text
  amountClaimed       Decimal   @db.Decimal(10, 2)
  amountApproved      Decimal?  @db.Decimal(10, 2)
  decisionReason      String?   @db.Text
  
  submittedAt         DateTime  @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?
  decisionAt          DateTime?
  completedAt         DateTime?
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy              Policy    @relation(fields: [policyId], references: [id])
  documents           ClaimDocument[]
  notes               ClaimNote[]
  payments            Payment[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@index([userId])
  @@index([policyId])
  @@index([status])
  @@index([referenceNumber])
}

model ClaimNote {
  id              String    @id @default(cuid())
  claimId         String
  note            String    @db.Text
  createdBy       String
  isInternalOnly  Boolean   @default(true)
  createdAt       DateTime  @default(now())
  
  claim           Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  
  @@index([claimId])
}

enum DocumentType {
  ID_COPY
  DEATH_CERTIFICATE
  POLICY_DOCUMENT
  BANK_CONFIRMATION
  FUNERAL_BILL
  SUPPORTING_DOCUMENT
  OTHER
}

model Document {
  id              String    @id @default(cuid())
  userId          String
  fileName        String
  fileSize        Int
  mimeType        String
  documentType    DocumentType @default(OTHER)
  storagePath     String    @unique
  description     String?
  isVerified      Boolean   @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  isPrivate       Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationDocuments ApplicationDocument[]
  claimDocuments  ClaimDocument[]
  
  @@index([userId])
  @@index([isPrivate])
}

model ApplicationDocument {
  id              String    @id @default(cuid())
  applicationId   String
  documentId      String
  createdAt       DateTime  @default(now())
  
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document        Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@unique([applicationId, documentId])
  @@index([applicationId])
}

model ClaimDocument {
  id              String    @id @default(cuid())
  claimId         String
  documentId      String
  createdAt       DateTime  @default(now())
  
  claim           Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@unique([claimId, documentId])
  @@index([claimId])
}

enum CateringEnquiryStatus {
  SUBMITTED
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

model CateringPackage {
  id                String    @id @default(cuid())
  name              String
  description       String?   @db.Text
  servingSize       Int
  pricePerPerson    Decimal   @db.Decimal(10, 2)
  features          String[]  @default([])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  enquiries         CateringEnquiry[]
  
  @@index([isActive])
}

model CateringEnquiry {
  id                String    @id @default(cuid())
  referenceNumber   String    @unique
  userId            String
  packageId         String?
  status            CateringEnquiryStatus @default(SUBMITTED)
  
  deceasedName      String
  funeralDate       DateTime
  venueLocation     String
  estimatedGuests   Int
  specialRequirements String? @db.Text
  
  quotedPrice       Decimal?  @db.Decimal(10, 2)
  quotedAt          DateTime?
  acceptedAt        DateTime?
  completedAt       DateTime?
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  package           CateringPackage? @relation(fields: [packageId], references: [id])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
}

enum TombstoneEnquiryStatus {
  SUBMITTED
  QUOTED
  ACCEPTED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model TombstoneProduct {
  id                String    @id @default(cuid())
  name              String
  description       String?   @db.Text
  materialType      String
  basePrice         Decimal   @db.Decimal(10, 2)
  customizationOptions String[] @default([])
  imageUrl          String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  enquiries         TombstoneEnquiry[]
  
  @@index([isActive])
}

model TombstoneEnquiry {
  id                  String    @id @default(cuid())
  referenceNumber     String    @unique
  userId              String
  productId           String?
  status              TombstoneEnquiryStatus @default(SUBMITTED)
  
  deceasedFirstName   String
  deceasedLastName    String
  deceasedDateOfBirth DateTime?
  deceasedDateOfDeath DateTime
  burialLocation      String?
  
  selectedOptions     String[]  @default([])
  customSpecifications String? @db.Text
  referenceImages     String[]  @default([])
  
  quotedPrice         Decimal?  @db.Decimal(10, 2)
  quotedAt            DateTime?
  acceptedAt          DateTime?
  completedAt         DateTime?
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             TombstoneProduct? @relation(fields: [productId], references: [id])
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
}

enum CashPayoutStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DECLINED
  COMPLETED
}

model CashPayoutApplication {
  id                  String    @id @default(cuid())
  referenceNumber     String    @unique
  userId              String
  status              CashPayoutStatus @default(SUBMITTED)
  
  firstName           String
  lastName            String
  email               String
  phone               String
  identificationNumber String
  
  applicationReason   String    @db.Text
  requestedAmount     Decimal?  @db.Decimal(10, 2)
  approvedAmount      Decimal?  @db.Decimal(10, 2)
  bankAccountNumber   String?
  bankName            String?
  
  submittedAt         DateTime  @default(now())
  reviewedAt          DateTime?
  decisionAt          DateTime?
  processedAt         DateTime?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  PREMIUM
  CATERING
  TOMBSTONE
  CASH_PAYOUT
  SERVICE
  DEPOSIT
}

model Payment {
  id                String    @id @default(cuid())
  referenceNumber   String    @unique
  userId            String
  type              PaymentType
  status            PaymentStatus @default(PENDING)
  
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("ZAR")
  description       String?
  
  policyId          String?
  claimId           String?
  
  paymentMethod     String?
  transactionId     String?   @unique
  gatewayResponse   String?   @db.Text
  
  paidAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy            Policy?   @relation(fields: [policyId], references: [id])
  claim             Claim?    @relation(fields: [claimId], references: [id])
  attempts          PaymentAttempt[]
  
  @@index([userId])
  @@index([status])
  @@index([transactionId])
}

model PaymentAttempt {
  id                String    @id @default(cuid())
  paymentId         String
  status            PaymentStatus @default(PENDING)
  
  amount            Decimal   @db.Decimal(10, 2)
  method            String
  gatewayResponse   String?   @db.Text
  errorCode         String?
  errorMessage      String?
  
  createdAt         DateTime  @default(now())
  
  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  @@index([paymentId])
}

model DebitOrder {
  id                String    @id @default(cuid())
  policyId          String
  status            String    @default("ACTIVE")
  
  amount            Decimal   @db.Decimal(10, 2)
  frequency         String    @default("MONTHLY")
  dayOfMonth        Int       @default(1)
  
  mandateId         String?
  mandateStatus     String    @default("PENDING")
  mandateCreatedAt  DateTime?
  mandateExpiresAt  DateTime?
  
  lastDebitDate     DateTime?
  nextDebitDate     DateTime?
  failureCount      Int       @default(0)
  lastFailureReason String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  policy            Policy    @relation(fields: [policyId], references: [id])
  
  @@index([policyId])
  @@index([status])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  title             String
  message           String    @db.Text
  type              String
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  actionUrl         String?
  
  createdAt         DateTime  @default(now())
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isRead])
}

model Message {
  id                String    @id @default(cuid())
  senderId          String
  recipientId       String
  subject           String?
  body              String    @db.Text
  isRead            Boolean   @default(false)
  readAt            DateTime?
  relatedEntityId   String?
  relatedEntityType String?
  
  createdAt         DateTime  @default(now())
  
  sender            User      @relation("MessageSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient         User      @relation("MessageReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  
  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id                String    @id @default(cuid())
  ticketNumber      String    @unique
  userId            String
  subject           String
  description       String    @db.Text
  status            TicketStatus @default(OPEN)
  priority          String    @default("NORMAL")
  
  assignedTo        String?
  resolvedAt        DateTime?
  resolutionNotes   String?   @db.Text
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  closedAt          DateTime?
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
}

model AuditLog {
  id                String    @id @default(cuid())
  userId            String
  action            String
  entityType        String
  entityId          String
  changes           String?   @db.Text
  reason            String?   @db.Text
  metadata          String?   @db.Text
  ipAddress         String?
  userAgent         String?
  
  createdAt         DateTime  @default(now())
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
}

model SystemSetting {
  id                String    @id @default(cuid())
  key               String    @unique
  value             String    @db.Text
  description       String?
  category          String?
  isPublic          Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([category])
}
