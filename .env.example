# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kganya"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kganya Royal Funeral Services"

# Email Service
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@kganya.local"
EMAIL_SUPPORT="support@kganya.local"

# File Storage
NEXT_PUBLIC_STORAGE_URL="http://localhost:3000/uploads"
STORAGE_MAX_FILE_SIZE="5242880"

# Payment Gateway (South African)
PAYMENT_PUBLIC_KEY="your-payment-public-key"
PAYMENT_SECRET_KEY="your-payment-secret-key"
PAYMENT_WEBHOOK_SECRET="your-webhook-secret"

# AWS S3 (Optional)
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="kganya-documents"

# Debit Order Provider
DEBIT_ORDER_PROVIDER_KEY="your-provider-key"
DEBIT_ORDER_PROVIDER_SECRET="your-provider-secret"
